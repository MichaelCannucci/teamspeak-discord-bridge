[Unit]
Description=TeamSpeak <-> Discord audio bridge bot
After=ts6-client.service pipewire.service pipewire-pulse.service
Wants=ts6-client.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/teamspeak-discord-bridge
ExecStartPre=/usr/bin/env bash -c 'until pactl info >/dev/null 2>&1; do sleep 1; done'
ExecStart=/usr/bin/env node dist/index.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
