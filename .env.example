# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Discord guild (server) ID that the bridge operates in
DISCORD_GUILD_ID=123456789012345678

# Discord voice channel ID the bot should join
DISCORD_VOICE_CHANNEL_ID=123456789012345678

# Optional: text channel for bridge status/announcements
DISCORD_TEXT_CHANNEL_ID=

# PulseAudio/PipeWire device names (must match setup-audio.sh)
# Sink the TS6 client plays into (bot captures its monitor)
TS_SINK_NAME=ts-bridge-out
# Virtual source the TS6 client uses as microphone (bot writes into it)
TS_SOURCE_NAME=ts-bridge-in

# Audio format (Discord uses 48kHz stereo s16le internally)
SAMPLE_RATE=48000
CHANNELS=2

# Optional: announce speaker names via TTS on the TS side
ANNOUNCE_SPEAKERS=false
